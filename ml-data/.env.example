# EdgeGuard AI — ML Pipeline environment variables
# Copy to .env and fill in the real values (never commit .env to git).

# ── Supabase connection (same values as backend/.env) ─────────────────────
# Get these from the Supabase dashboard → Project Settings → API
# The "secret" key starts with sb_secret_ in newer Supabase projects
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=sb_secret_YOUR_SUPABASE_SERVICE_KEY_HERE

# ── Poller configuration ───────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
TRUCK_ID=truck1
ALERT_THRESHOLD=0.70
POLL_INTERVAL_SECONDS=10
HISTORY_LIMIT=50
COMPONENT_NAME=hydraulic_system
MODEL_VERSION=v2
LOG_PATH=predictions_log.jsonl

# ── Gemini LLM (AI Engine 5 — Mining Operations Copilot) ──────────────────
# Get this from https://aistudio.google.com/app/apikey
# Without this, the copilot runs in deterministic-template mode (still works)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional copilot tuning
# EDGEGUARD_GEMINI_MODEL=gemini-1.5-flash
# EDGEGUARD_GEMINI_MAX_TOKENS=512
